; ============================================================
; Variabel Quick Settings — state tiap toggle card
; Nilai awal dummy, init.sh update waktu EWW start
; ============================================================

; WiFi via deflisten — watcher native baca state NetworkManager,
; emit off | on | <SSID> | animasi titik saat proses koneksi
(deflisten qs_wifi :initial "off" "scripts/quick-settings/watch-wifi.sh")

; Bluetooth via deflisten — watcher native baca bluetoothctl,
; emit off | on | <device> | animasi ● saat blueman dibuka/ditutup
(deflisten qs_bluetooth :initial "off" "scripts/quick-settings/watch-bluetooth.sh")
(defvar qs_tethering "off")
(defvar qs_airplane "off")
(defvar qs_nightlight "off")
(defvar qs_dnd "off")
; Power Mode via deflisten — event-driven DBus, sinkron dengan waybar
; emit safe | balanced | performance
(deflisten qs_powermode :initial "balanced" "/home/xuanz/.config/collab-scripts/power-mode.sh watch")
(defvar qs_theme "dark")

; (defpoll konektivitas dihapus — WiFi & Bluetooth sudah deflisten masing-masing)
