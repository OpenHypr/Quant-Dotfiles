; ============================================================
; Window Volume Mixer — popup di kanan atas
; Toggle dengan Super+F3 atau klik waybar module
; ============================================================

(defwindow mixer
  :monitor 0
  :geometry (geometry
    :x "5"
    :y "5"
    :width "280"
    :height "1"
    :anchor "top right"
  )
  :stacking "overlay"
  :namespace "mixer"
  :windowtype "dock"
  :focusable false

  (mixer-content)
)
