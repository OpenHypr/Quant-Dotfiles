; ============================================================
; Widget Volume Mixer — daftar per-aplikasi audio
; Icon & volume dikomputasi di watch.sh, widget tinggal render
; ============================================================

; --- Satu entry aplikasi ---
(defwidget mixer-entry [app]
  (box
    :class "mixer-entry"
    :orientation "vertical"
    :spacing 4

    ; Baris atas: icon + nama app + volume text + mute button
    (box
      :class "mixer-entry-header"
      :orientation "horizontal"
      :spacing 8
      :halign "fill"

      ; Icon
      (label
        :class "mixer-icon"
        :text "${app.icon}"
        :width 22
      )

      ; Nama aplikasi
      (label
        :class "mixer-name"
        :text "${app.app_name}"
        :wrap false
        :hexpand true
        :halign "start"
      )

      ; Volume text
      (label
        :class "${app.mute ? 'mixer-volume-text muted' : 'mixer-volume-text'}"
        :text "${app.mute ? 'MUTED' : app.volume + '%'}"
        :width 42
        :wrap false
      )

      ; Mute toggle button
      (button
        :class "mixer-mute-btn"
        :onclick "scripts/mixer/toggle-mute.sh ${app.index}"
        (label
          :class "${app.mute ? 'mixer-mute-icon muted' : 'mixer-mute-icon'}"
          :text "${app.mute ? '' : ''}"
        )
      )
    )

    ; Baris bawah: native scale slider (knob draggable)
    (scale
      :class "${app.mute ? 'mixer-slider muted' : 'mixer-slider'}"
      :min 0
      :max 100
      :value "${app.volume}"
      :onchange "scripts/mixer/set-volume-exact.sh ${app.index} {}"
    )
  )
)

; --- Konten utama mixer ---
(defwidget mixer-content []
  (box
    :class "mixer-container popup"
    :orientation "vertical"
    :spacing 8
    :halign "fill"
    :valign "center"

    ; Header bar — centerbox selalu full width
    (centerbox
      :class "mixer-header"
      (box)
      (label :class "mixer-title" :text "󰋋  Volume Mixer")
      (box)
    )

    ; List aplikasi — kalau kosong, for loop render nothing
    (for app in mixer_apps
      (mixer-entry :app app)
    )
  )
)
