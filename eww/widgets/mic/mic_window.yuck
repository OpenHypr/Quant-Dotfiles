; ============================================================
; Window Mic Mixer — popup di kanan atas
; Toggle dengan Super+F4
; ============================================================

(defwindow mic-mixer
  :monitor 0
  :geometry (geometry
    :x "5"
    :y "5"
    :width "402"
    :height "1"
    :anchor "top right"
  )
  :stacking "overlay"
  :namespace "mic-mixer"
  :windowtype "dock"
  :focusable false

  (mic-content)
)
