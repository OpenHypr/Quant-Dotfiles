; ============================================================
; Window OSD — wadah popup volume/brightness
; ============================================================

(defwindow osd
  :monitor 0
  :geometry (geometry
    :x "50%"
    :y "5"
    :width "240"
    :height "1"
    :anchor "bottom center"
  )
  :stacking "overlay"
  :namespace "osd"
  :windowtype "dock"
  :focusable false

  (osd-content)
)
