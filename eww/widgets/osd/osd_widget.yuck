; ============================================================
; Widget OSD — isi popup volume/brightness
; Bisa dipanggil ulang di control center atau OSD lain
; ============================================================

(defwidget osd-content []
  (box
    :class "osd-container popup"
    :orientation "horizontal"
    :spacing 0
    :halign "center"
    :valign "center"

    ; Kiri: [icon] [persentase]
    (box
      :orientation "horizontal"
      :spacing 1
      :halign "start"
      :valign "left"

      (label
        :class "osd-icon"
        :text "${osd_icon}"
        :width 1
      )

      (label
        :class "osd-value"
        :text "${osd_value}%"
        :width 30
        :wrap false
      )
    )

    ; Kanan: progress bar
    (progress-bar :value osd_progress :height 10)
  )
)
