; ============================================================
; Window Quick Settings — popup di kanan atas
; Toggle dengan Ctrl+Menu
; ============================================================

(defwindow quick-settings
  :monitor 0
  :geometry (geometry
    :x "5"
    :y "5"
    :width "402"
    :height "298"
    :anchor "top right"
  )
  :stacking "overlay"
  :namespace "quick-settings"
  :windowtype "dock"
  :focusable false

  (qs-content)
)
