; ============================================================
; Window Power Menu — popup di kanan atas
; Toggle dengan Super+Q
; ============================================================

(defwindow power-menu
  :monitor 0
  :geometry (geometry
    :x "5"
    :y "5"
    :width "402"
    :height "1"
    :anchor "top right"
  )
  :stacking "overlay"
  :namespace "power-menu"
  :windowtype "dock"
  :focusable false

  (power-menu-content)
)
