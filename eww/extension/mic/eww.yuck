; ============================================================
; Extension: Mic Mixer — kontrol mic (PipeWire source)
; Style berbagi class dengan volume mixer
; ============================================================

; --- Variabel ---
(deflisten mic_data :initial "{\"master\":{\"index\":0,\"app_name\":\"Microphone\",\"mute\":false,\"volume\":0,\"icon\":\"󰍬\"},\"apps\":[]}" "extension/mic/scripts/watch-mic.sh")

; --- Widget: satu entry mic ---
(defwidget mic-entry [app]
  (box :class "mixer-entry" :orientation "vertical" :spacing 4
    (box :class "mixer-entry-header" :orientation "horizontal" :spacing 8 :halign "fill"
      (label :class "mixer-icon" :text "${app.icon}" :width 22)
      (label :class "mixer-name" :text "${app.app_name}" :wrap false :hexpand true :halign "start")
      (label :class "${app.mute ? 'mixer-volume-text muted' : 'mixer-volume-text'}"
             :text "${app.mute ? 'MUTED' : app.volume + '%'}" :width 42 :wrap false)
      (button :class "mixer-mute-btn" :onclick "extension/mic/scripts/toggle-mic.sh ${app.index}"
        (label :class "${app.mute ? 'mixer-mute-icon muted' : 'mixer-mute-icon'}"
               :text "${app.mute ? '' : ''}")))
    (scale :class "${app.mute ? 'mixer-slider muted' : 'mixer-slider'}"
           :min 0 :max 100 :value "${app.volume}"
           :onchange "extension/mic/scripts/mic-set-volume.sh ${app.index} {}")))

; --- Widget: konten mic ---
(defwidget mic-content []
  (box :class "mixer-container popup" :orientation "vertical" :spacing 8 :halign "fill" :valign "center"
    (centerbox :class "mixer-header"
      (box)
      (label :class "mixer-title" :text "󰍬  Mic Mixer")
      (box))
    (mic-entry :app {mic_data.master})
    (for app in {mic_data.apps}
      (mic-entry :app app))))

; --- Window ---
(defwindow mic-mixer
  :monitor 0
  :geometry (geometry
    :x "5"
    :y "5"
    :width "402"
    :height "1"
    :anchor "top right"
  )
  :stacking "overlay"
  :namespace "mic-mixer"
  :windowtype "dock"
  :focusable false

  (mic-content)
)
